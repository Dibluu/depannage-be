# Supabase — https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Resend (email confirmation) — https://resend.com
RESEND_API_KEY=re_xxxx

# Supabase service role (server only) — used by /api/bookings to insert bookings and upload photos
SUPABASE_SERVICE_ROLE_KEY=

# Booking notifications (Resend) — every booking is emailed here
BOOKING_NOTIFY_EMAIL=
# Leave empty to use Resend's test sender (delivers only to the Resend account's own email)
BOOKING_FROM_EMAIL=

# Public contact — shows call buttons on every page when set
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_WHATSAPP=

# SEO
NEXT_PUBLIC_SITE_URL=https://www.xn--dpannage-b1a.be
# Local-page rollout wave (see lib/seo/rollout.js). 1 = locksmith Brussels + Walloon Brabant.
SEO_ACTIVE_WAVE=1

# DataForSEO (local research scripts only, never exposed to the site)
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
